    "keywords": ["rep", "finder", "bright", "cloud", "contao"],
    "type": "contao-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Bright Cloud Studio",
            "homepage": "https://brightcloudstudio.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "BrightCloudStudio\\RepFinderBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "BrightCloudStudio\\RepFinderBundle\\ContaoManager\\Plugin"
    }
